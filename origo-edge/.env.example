ORIGO_ENV=local
ORIGO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/origo
ORIGO_REDIS_URL=redis://localhost:6379/0
ORIGO_AUTH_DISABLED=true
ORIGO_EDGE_DEVICE_TOKEN=dev-only-change-me
ORIGO_CORS_ORIGINS=["http://localhost:5173"]

# Docker device-loop (see docs/docker-device-loop.md) — off by default.
# Requires: `make images` built, and a Docker daemon reachable from wherever
# `make dev-edge` runs origo-edge (this process talks to the host's Docker socket
# directly via docker.from_env() — it does not itself run in a container).
ORIGO_DEVICE_PROVISIONING_ENABLED=false
ORIGO_DOCKER_NETWORK=origo-net
ORIGO_SPACE_IMAGE=origo-space:latest
ORIGO_TERRESTRIAL_IMAGE=origo-terrestrial:latest
ORIGO_STATION_AGENT_IMAGE=origo-station-agent:latest
ORIGO_EDGE_PUBLIC_URL=http://host.docker.internal:8000
