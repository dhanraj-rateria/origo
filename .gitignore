# --- Vendored/build artifacts (never source, sometimes binary, always machine-specific) ---
# Populated locally per docs/docker-device-loop.md from your own /usr/local wolfSSL
# build — headers and .so files, not something to commit.
vendor/

# Generated gRPC stubs — regenerated by `make proto*` / gen_proto.py, not hand-written.
**/_proto/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
.vite/

# --- Secrets / local config ---
.env
origo-edge/.env
origo-station-agent/.env
!*.env.example

# --- Locally-generated identity/key material ---
# IdentityStore writes these; they're private keys, not source, and running any
# module directly (outside Docker/tests) drops one at the CWD by default.
*identity*.json
terrestrial-identity.json
space.json

# --- OS / editor ---
.DS_Store
*.swp

# --- Miscellaneous ---
**/certs/