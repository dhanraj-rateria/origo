ORIGO_STATION_STATION_REF=gs-north
ORIGO_STATION_SATELLITE_REF=aster-1
ORIGO_STATION_ORIGO_EDGE_URL=http://localhost:8000
ORIGO_STATION_ORIGO_ENDPOINT=unix:///var/run/origo/origo-terrestrial.sock
# mTLS cert paths are required by SyncClient's constructor even against the dev token
# path above — for pure local dev without real certs, point these at any placeholder
# PEM files; sync_client.py's httpx.AsyncClient will still work against a plain HTTP
# origo-edge as long as ORIGO_AUTH_DISABLED lets the request through unauthenticated.
ORIGO_STATION_DEVICE_CERT_PATH=./dev-certs/station.crt
ORIGO_STATION_DEVICE_KEY_PATH=./dev-certs/station.key
ORIGO_STATION_CA_BUNDLE_PATH=./dev-certs/ca.pem